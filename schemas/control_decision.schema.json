{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Control-plane decision (radiation.control.decision/1)",
 "type": "object",
 "required": [
  "schema_name",
  "task_id",
  "effect",
  "source",
  "status",
  "tool",
  "bounds",
  "reasons",
  "decided_at",
  "digest"
 ],
 "properties": {
  "schema_name": {
   "const": "radiation.control.decision/1"
  },
  "task_id": {
   "oneOf": [
    {
     "type": "string",
     "pattern": "^TID-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9][a-z0-9-]{0,63}$"
    },
    {
     "description": "documented legacy identity (genesis ratification record)",
     "enum": ["RADIATION-5000"]
    }
   ]
  },
  "effect": {
   "enum": [
    "read",
    "workspace_draft",
    "canonical_apply"
   ]
  },
  "source": {
   "enum": [
    "session_initiative",
    "standing_policy",
    "commander_order"
   ]
  },
  "status": {
   "enum": [
    "authorized",
    "refused",
    "commander_motor_act"
   ]
  },
  "bounds": {
   "type": "object"
  },
  "reasons": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "decided_at": {
   "type": "string",
   "minLength": 1
  },
  "digest": {
   "type": "string",
   "pattern": "^sha256:[0-9a-f]{64}$"
  }
 }
}