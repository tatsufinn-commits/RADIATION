{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manual verdict advisory record V0.1A",
  "description": "Closed non-executing advisory shape. Cross-field set equality, uniqueness, selection, linkage, and append-only history are enforced by tests because the repository executor does not support those relational keywords.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "record_id", "created_at", "objective", "considered_paths", "selection", "rejected_residuals", "capability_limitations", "retained_blockers", "outcome", "analyze_invoked", "advisory_only", "execution_authorized", "blockers_cleared", "advisory_seal", "commander_visibility", "history"],
  "properties": {
    "schema_name": {"const": "radiation.verdict/0.1a"},
    "record_id": {"type": "string", "pattern": "^VR-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Za-z0-9._-]+$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "objective": {"type": "object", "additionalProperties": false, "required": ["statement", "scope", "exclusions"], "properties": {"statement": {"type": "string", "minLength": 1}, "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "considered_paths": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["path_id", "summary", "tradeoffs"], "properties": {"path_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "summary": {"type": "string", "minLength": 1}, "tradeoffs": {"type": "string", "minLength": 1}}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["path_id", "rationale"], "properties": {"path_id": {"type": "string", "minLength": 1}, "rationale": {"type": "string", "minLength": 1}}},
    "rejected_residuals": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["path_id", "residual"], "properties": {"path_id": {"type": "string", "minLength": 1}, "residual": {"type": "string", "minLength": 1}}}},
    "capability_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "retained_blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outcome": {"enum": ["advisory", "blocked", "refused", "hold"]},
    "analyze_invoked": {"const": 0},
    "advisory_only": {"const": true},
    "execution_authorized": {"const": false},
    "blockers_cleared": {"const": false},
    "advisory_seal": {"type": "object", "additionalProperties": false, "required": ["record_complete", "meaning"], "properties": {"record_complete": {"const": true}, "meaning": {"const": "record-completeness-only-not-commander-approval-or-repository-seal"}}},
    "commander_visibility": {"type": "object", "additionalProperties": false, "required": ["reported", "verified", "authentication_claimed"], "properties": {"reported": {"type": "boolean"}, "verified": {"const": false}, "authentication_claimed": {"const": false}}},
    "history": {"type": "object", "additionalProperties": false, "required": ["supersedes_record_id", "rewrites_prior_record"], "properties": {"supersedes_record_id": {"type": "string"}, "rewrites_prior_record": {"const": false}}}
  }
}
