 "required": [
  "schema_name",
  "cwd",
  "argv"
 ],
 "properties": {
  "schema_name": {
   "const": "radiation.tool_io.push_preflight_check.inputs/1"
  },
  "cwd": {
   "const": "repo-root"
  },
  "argv": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "anyOf": [
     {
      "enum": [
       "--base",
       "--self-test"
      ]
     },
     {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
     }
    ]
   }
  }
 }
}
