{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Plan",
 "type": "object",
 "required": [
  "schema_version",
  "plan_id",
  "task_id",
  "base_revision",
  "steps"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0"
  },
  "plan_id": {
   "type": "string"
  },
  "task_id": {
   "type": "string"
  },
  "base_revision": {
   "type": "string",
   "minLength": 7
  },
  "steps": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "step_id",
     "operation_class",
     "success_predicate"
    ],
    "properties": {
     "step_id": {
      "type": "string"
     },
     "operation_class": {
      "type": "string"
     },
     "success_predicate": {
      "type": "string",
      "minLength": 4
     }
    }
   }
  }
 }
}